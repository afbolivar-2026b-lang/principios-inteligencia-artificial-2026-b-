# Variables del SERVIDOR (se ponen en Vercel → Settings → Environment Variables). Sin valores aquí: nunca se suben llaves a GitHub.

# Llave de la API de Anthropic (se crea en console.anthropic.com → API Keys). Empieza por sk-ant-
ANTHROPIC_API_KEY=

# Código de acceso que TÚ inventas (largo, 20 o más letras y números). Es el mismo que escribes en la app: Ajustes → Inteligencia artificial.
CODIGO_ACCESO=

# Opcional: otro modelo de Claude. Si no lo pones, se usa claude-haiku-5-5
MODELO_IA=
